{
  "manifest_version": 2,
  "name": "Sockfish Extension Probe MV2",
  "version": "1.0.0",
  "description": "Local test fixture; reports API presence and a storage.local round trip only.",
  "permissions": ["storage", "tabs", "http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Sockfish Probe",
    "default_popup": "popup.html"
  }
}
