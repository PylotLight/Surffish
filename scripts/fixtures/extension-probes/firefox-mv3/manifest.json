{
  "manifest_version": 3,
  "name": "Surffish Firefox Extension Probe",
  "version": "1.0.0",
  "description": "A local-only representative Firefox package shape; not an actual password-manager extension.",
  "browser_specific_settings": {
    "gecko": {
      "id": "surffish-firefox-probe@example.invalid",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["main-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Firefox Probe",
    "default_popup": "popup.html"
  }
}
