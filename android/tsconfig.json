{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["app/**/*", "src/**/*", "modules/**/*.ts", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", "android"]
}
