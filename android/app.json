{
  "expo": {
    "name": "Surffish",
    "slug": "surffish",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "surffish",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.pylotlight.surffish",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#dcecf9"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "backgroundColor": "#f6f7f9",
          "dark": { "image": "./assets/splash.png", "backgroundColor": "#0f1115" }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true,
            "extraMavenRepos": ["https://maven.mozilla.org/maven2/"]
          }
        }
      ],
      "./plugins/withSurffishAndroid.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
