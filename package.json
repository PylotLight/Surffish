{
  "name": "surffish",
  "version": "0.1.1",
  "author": "PylotLight",
  "description": "A compact Electron browser with a local SOCKS5 proxy toggle",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "bun scripts/build-mac-trackpad-swipe.ts --dev && bun scripts/build-google-sign-in.ts && electron-vite dev",
    "build": "electron-vite build && bun scripts/build-mac-trackpad-swipe.ts && bun scripts/build-google-sign-in.ts",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "release": "bun scripts/release.ts",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out",
    "typecheck": "bun check",
    "test": "bun test --parallel=4 scripts/ensure-dependencies.test.ts scripts/native-build-cache.test.ts scripts/render-cask.test.ts scripts/release-version.test.ts src/preload/mac-trackpad-swipe.test.cjs src/shared/navigation.test.ts src/shared/external-links.test.ts src/shared/persistence.test.ts src/shared/autocomplete.test.ts src/shared/site-permissions.test.ts src/shared/quick-links.test.ts src/shared/quick-links-backgrounds.test.ts src/shared/new-tab-photo-feed.test.ts src/shared/password-extension-compat.test.ts src/shared/downloads.test.ts src/shared/window-geometry.test.ts src/shared/world-cities.test.ts src/renderer/src/views/useTabDragSort.test.ts src/main/renderer-security.test.ts src/main/focus-address-shortcut.test.ts src/main/adblock.test.ts src/main/google-webkit-sign-in.test.ts src/main/adblock-filters.test.ts src/main/bramble-poc-adapter.test.ts src/main/bramble-release.test.ts src/main/crx.test.ts src/main/extension-staging.test.ts src/main/web-store-extension-adapter.test.ts src/shared/chrome-web-store.test.ts src/shared/extension-compat.test.ts src/shared/extension-tabs.test.ts src/shared/clean-link.test.ts src/shared/zoom.test.ts src/shared/pdf-editor.test.ts src/shared/pdf-page-ops.test.ts src/shared/update-feed.test.ts",
    "test:electron-security": "electron scripts/electron-security-smoke.cjs",
    "test:electron-downloads": "electron scripts/electron-download-manager-smoke.cjs",
    "test:electron-pdf-editor": "node scripts/electron-pdf-editor-smoke.mjs",
    "test:electron-sidebar-overlay": "electron scripts/electron-sidebar-overlay-smoke.cjs",
    "test:electron-table-stakes": "electron scripts/electron-table-stakes-smoke.cjs",
    "test:electron-updates": "electron scripts/electron-updates-smoke.cjs",
    "test:electron-adblock": "electron scripts/electron-adblock-smoke.cjs",
    "test:electron-youtube": "electron scripts/electron-adblock-youtube.cjs",
    "test:electron-adblock-sites": "electron scripts/electron-adblock-youtube.cjs --sites",
    "test:electron-extensions": "node scripts/run-electron-extension-probes.cjs",
    "test:electron-host-bridge": "node scripts/run-electron-host-tab-frame-probe.cjs",
    "test:bramble-poc": "node --experimental-strip-types scripts/check-bramble-poc.ts",
    "test:bramble-app-poc": "node scripts/check-bramble-app-poc.mjs",
    "probe:electron-extension-real": "electron scripts/electron-real-extension-probe.cjs",
    "probe:web-store-extension": "bun scripts/fetch-web-store-extension.ts",
    "check:password-extension": "node --experimental-strip-types scripts/check-password-extension.ts",
    "postinstall": "install-electron"
  },
  "build": {
    "appId": "com.pylotlight.surffish",
    "productName": "Surffish",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/native/**/*.node",
      "out/native/google-sign-in"
    ],
    "protocols": [
      {
        "name": "Web site URL",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "src/resources/icons/Surffish.icns",
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "en",
        "en_GB"
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          },
          {
            "CFBundleTypeName": "PDF document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          }
        ]
      }
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "node-api-headers": "^1.9.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts-experimental": "^7.4.10"
  }
}
