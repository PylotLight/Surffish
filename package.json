{
  "name": "surffish",
  "version": "0.1.0",
  "author": "PylotLight",
  "description": "A compact Electron browser with a local SOCKS5 proxy toggle",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:bare": "bun scripts/build-mac-trackpad-swipe.ts --dev && electron-vite dev",
    "build": "electron-vite build && bun scripts/build-mac-trackpad-swipe.ts",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "start": "electron ./out/main/index.js",
    "preview": "electron-vite preview",
    "clean": "rm -rf out",
    "typecheck": "bun check",
    "test": "bun test --parallel=4 scripts/ensure-dependencies.test.ts scripts/native-build-cache.test.ts scripts/render-cask.test.ts src/preload/mac-trackpad-swipe.test.cjs src/shared/navigation.test.ts src/shared/persistence.test.ts src/shared/autocomplete.test.ts src/shared/quick-links.test.ts src/shared/quick-links-backgrounds.test.ts src/shared/new-tab-photo-feed.test.ts src/shared/password-extension-compat.test.ts src/shared/downloads.test.ts src/shared/window-geometry.test.ts src/main/renderer-security.test.ts src/main/adblock.test.ts src/main/adblock-filters.test.ts src/main/bramble-poc-adapter.test.ts src/main/bramble-release.test.ts",
    "test:electron-security": "electron scripts/electron-security-smoke.cjs",
    "test:electron-downloads": "electron scripts/electron-download-manager-smoke.cjs",
    "test:electron-sidebar-overlay": "electron scripts/electron-sidebar-overlay-smoke.cjs",
    "test:electron-adblock": "electron scripts/electron-adblock-smoke.cjs",
    "test:electron-youtube": "electron scripts/electron-adblock-youtube.cjs",
    "test:electron-adblock-sites": "electron scripts/electron-adblock-youtube.cjs --sites",
    "test:electron-extensions": "node scripts/run-electron-extension-probes.cjs",
    "test:electron-host-bridge": "node scripts/run-electron-host-tab-frame-probe.cjs",
    "test:bramble-poc": "node --experimental-strip-types scripts/check-bramble-poc.ts",
    "test:bramble-app-poc": "node scripts/check-bramble-app-poc.mjs",
    "probe:electron-extension-real": "electron scripts/electron-real-extension-probe.cjs",
    "check:password-extension": "node --experimental-strip-types scripts/check-password-extension.ts",
    "postinstall": "install-electron"
  },
  "build": {
    "appId": "com.pylotlight.surffish",
    "productName": "Surffish",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/native/**/*.node"
    ],
    "mac": {
      "icon": "resources/icons/Surffish.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "node-api-headers": "^1.9.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts-experimental": "^7.4.10"
  }
}
